JWT_SECRET="some-long-random-string-change-this-later"

# ── Email ──────────────────────────────────────────────
# DEV/TEST MODE: leave SMTP_* unset. The backend auto-creates an Ethereal
# test inbox and logs a preview URL to the console — nothing is sent to a
# real address.
EMAIL_FROM="K18 Store <no-reply@k18.test>"

# PRODUCTION: fill these with real SMTP credentials (e.g. Resend, Mailgun,
# SendGrid, or your provider's SMTP) and the app switches automatically —
# no code change. Do NOT commit real values.
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASS=""